# Copy to .env.local and fill in. Never commit real values.
# HMAC key for the session cookie, at least 32 characters.
DEMO_SECRET=
# JSON array of {login, hash, until}; create entries with: npm run add-account -- <login> <days>
DEMO_ACCOUNTS=[]
# Kill switch: set to false to close the demo for everyone.
DEMO_ENABLED=true
# Optional: WhatsApp Business number for the contact button, digits only. Without it the button opens Telegram.
NEXT_PUBLIC_WA_NUMBER=
