# Copy to .env.local and fill in. Never commit real values.
# HMAC key for the session cookie, at least 32 characters.
DEMO_SECRET=
# JSON array of {login, hash, until}; create entries with: npm run add-account -- <login> <days>
DEMO_ACCOUNTS=[]
# Kill switch: set to false to close the demo for everyone.
DEMO_ENABLED=true
# Optional: WhatsApp Business number for the contact button, digits only. Without it the button opens Telegram.
NEXT_PUBLIC_WA_NUMBER=
# Upstash Redis from the Vercel Marketplace (set automatically when the store is connected).
# Without them the demo runs on DEMO_ACCOUNTS only and /admin cannot save new logins.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Logins that see /admin, comma-separated. Default: pavel
ADMIN_LOGINS=pavel
# Optional: Telegram message to Pavel when a prospect logs in (bot token from @BotFather and his chat id).
DEMO_NOTIFY_TG_TOKEN=
DEMO_NOTIFY_CHAT_ID=
